@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="card">
    <div class="card-header">
        <h1 class="card-title">Manage your account</h1>
    </div>
    <div class="card-body">
        <div class="mb-4">
            <a href="/" class="btn btn-outline-secondary">Back to Home</a>
        </div>
        <h2 class="card-subtitle mb-3">Change your account settings</h2>
        <hr />
        <div class="row">
            <div class="col-lg-3 col-md-4">
                <div class="list-group">
                    <a class="list-group-item list-group-item-action" href="/Identity/Account/Manage/ChangePassword">Change Password</a>
                    <a class="list-group-item list-group-item-action" href="/Identity/Account/Manage/TwoFactorAuthentication">Two-Factor Authentication</a>
                    <a class="list-group-item list-group-item-action" href="/Identity/Account/Manage/PersonalData">Personal Data</a>
                </div>
            </div>
            <div class="col-lg-9 col-md-8">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

<footer class="mt-5 text-muted text-center">
    <p>Need help? <a href="/contact">Contact support</a>.</p>
</footer>

@section Scripts {
    @RenderSection("Scripts", required: false)
}