@page
@model SewPro.Areas.Identity.Pages.Roles.AssignRoleModel
@{
    ViewData["Title"] = "تعيين دور للمستخدم";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>
    <hr />

    <form method="post">
        <div class="form-group">
            <label for="userId">معرف المستخدم:</label>
            <input type="text" id="userId" name="userId" class="form-control" value="@Model.UserId" readonly />
        </div>

        <div class="form-group">
            <label for="roleName">اختر الدور:</label>
            <select id="roleName" name="roleName" class="form-control">
                @foreach (var role in Model.Roles)
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">تعيين الدور</button>
    </form>

    <div class="mt-3">
        <a asp-page="/Users/Index" class="btn btn-secondary">العودة إلى قائمة المستخدمين</a>
    </div>
</div>
