@model IEnumerable<SewPro.Models.Bill>

@{
    ViewData["Title"] = "قائمة الفواتير";
}

<h2>@ViewData["Title"]</h2>

<a href="@Url.Action("Create", "Bills")" class="btn btn-primary mb-3">إضافة فاتورة جديدة</a>

<table class="table">
    <thead>
        <tr>
            <th>المورد</th>
            <th>تاريخ الإصدار</th>
            <th>تاريخ الاستحقاق</th>
            <th>المبلغ</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bill in Model)
        {
            <tr>
                <td>@bill.Supplier.Name</td>
                <td>@bill.IssueDate.ToString("yyyy-MM-dd")</td>
                <td>@bill.DueDate.ToString("yyyy-MM-dd")</td>
                <td>@bill.Amount.ToString("C")</td>
                <td>
                    <a href="@Url.Action("Details", "Bills", new { id = bill.Id })" class="btn btn-info btn-sm">تفاصيل</a>
                    <a href="@Url.Action("Edit", "Bills", new { id = bill.Id })" class="btn btn-warning btn-sm">تعديل</a>
                    <a href="@Url.Action("Delete", "Bills", new { id = bill.Id })" class="btn btn-danger btn-sm">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
