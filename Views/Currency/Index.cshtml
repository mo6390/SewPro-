@model IEnumerable<SewPro.Models.CurrencyViewModel>

@{
    ViewData["Title"] = "قائمة العملات";
}

<h2>@ViewData["Title"]</h2>

<!-- إضافة زر لإضافة عملة جديدة -->
<a asp-action="Create" class="btn btn-primary">إضافة عملة جديدة</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>العملة الرئيسية عربي</th>
            <th>العملة الرئيسية إنجليزي</th>
            <th>العملة الفرعية عربي</th>
            <th>العملة الفرعية إنجليزي</th>
            <th>الكسور العشرية</th>
            <th>الجنسية عربي</th>
            <th>الجنسية إنجليزي</th>
            <th>الملاحظات</th>
            <th>العمليات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var currency in Model)
        {
            <tr>
                <td>@currency.MainCurrencyArabic</td>
                <td>@currency.MainCurrencyEnglish</td>
                <td>@currency.SubCurrencyArabic</td>
                <td>@currency.SubCurrencyEnglish</td>
                <td>@currency.SubCurrencyDecimal</td>
                <td>@currency.NationalityArabic</td>
                <td>@currency.NationalityEnglish</td>
                <td>@currency.Notes</td>
                <td>
                    <!-- يمكنك إضافة عمليات مثل التعديل والحذف هنا -->
                    <a asp-action="Edit" asp-route-id="@currency.Id" class="btn btn-warning">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@currency.Id" class="btn btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
