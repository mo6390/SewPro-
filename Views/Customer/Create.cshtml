@model SewPro.Models.Customer

<h2>إضافة عميل جديد</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Name">اسم العميل</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MobileNumber">رقم الجوال</label>
        <input asp-for="MobileNumber" class="form-control" />
        <span asp-validation-for="MobileNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NationalId">رقم الهوية</label>
        <input asp-for="NationalId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CommercialRegistration">السجل التجاري</label>
        <input asp-for="CommercialRegistration" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Address">العنوان</label>
        <input asp-for="Address" class="form-control" />
    </div>
       <div class="form-group">
        <label asp-for="Address">الرقم الضريبي</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="City">المدينة</label>
        <input asp-for="City" class="form-control" />
    </div>

    <!-- إخفاء أو جعل الحقل readonly -->
  

    <button type="submit" class="btn btn-success">إضافة</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>


