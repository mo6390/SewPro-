@model SewPro.Models.Customer

<h2>تفاصيل العميل</h2>

<div>
    <h4>معلومات العميل</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">كود العميل</dt>
        <dd class="col-sm-10">@Model.CustomerCode</dd>

        <dt class="col-sm-2">اسم العميل</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">رقم الجوال</dt>
        <dd class="col-sm-10">@Model.MobileNumber</dd>

        <dt class="col-sm-2">رقم الهوية</dt>
        <dd class="col-sm-10">@Model.NationalId</dd>

        <dt class="col-sm-2">السجل التجاري</dt>
        <dd class="col-sm-10">@Model.CommercialRegistration</dd>

        <dt class="col-sm-2">العنوان</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">المدينة</dt>
        <dd class="col-sm-10">@Model.City</dd>
    </dl>
</div>
<a asp-action="Index" class="btn btn-primary">العودة</a>
