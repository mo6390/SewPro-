@model SewPro.Models.Customer

<h2>تعديل بيانات العميل</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="CustomerId" />
    <div class="form-group">
        <label for="Name">اسم العميل</label>
        <input type="text" asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="MobileNumber">رقم الجوال</label>
        <input type="text" asp-for="MobileNumber" class="form-control" />
        <span asp-validation-for="MobileNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="NationalId">رقم الهوية</label>
        <input type="text" asp-for="NationalId" class="form-control" />
    </div>

    <div class="form-group">
        <label for="CommercialRegistration">السجل التجاري</label>
        <input type="text" asp-for="CommercialRegistration" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Address">العنوان</label>
        <input type="text" asp-for="Address" class="form-control" />
    </div>

    <div class="form-group">
        <label for="City">المدينة</label>
        <input type="text" asp-for="City" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">حفظ التعديلات</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
