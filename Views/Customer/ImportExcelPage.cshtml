@{
    ViewData["Title"] = "استيراد من إكسيل";
    Layout = "_Layout";
}

<h1>@ViewData["Title"]</h1>

<div class="mb-4">
    <a href="@Url.Action("Index", "Customer")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> العودة إلى قائمة العملاء
    </a>
</div>

<h3>استيراد بيانات العملاء من ملف إكسيل</h3>

<form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="file">اختر ملف إكسيل</label>
        <input type="file" name="file" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">استيراد</button>
</form>
