@model SewPro.Models.CustomerIndexViewModel

@{
    ViewData["Title"] = "قائمة العملاء";
    Layout = "_Layout";
}

<h1>@ViewData["Title"]</h1>

<!-- Search and Action Buttons -->
<div class="d-flex gap-2 flex-wrap mb-4 align-items-center">
    <!-- Search Form -->
    <form action="@Url.Action("Index", "Customer")" method="get" class="d-flex w-100">
        <div class="input-group w-50">
            <input type="text" id="searchQuery" name="searchQuery" 
                   class="form-control" 
                   placeholder="أدخل رقم الجوال أو كود العميل"
                   value="@Model.SearchQuery" 
                   aria-label="بحث عن العملاء">
            <div class="input-group-append">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> بحث
                </button>
            </div>
        </div>
    </form>

    <!-- Action Buttons -->
    <div class="d-flex gap-2">
        <!-- Add Customer Button -->
        <a href="@Url.Action("Create", "Customer")" class="btn btn-primary">
            <i class="fas fa-plus"></i> إضافة عميل جديد
        </a>

        <!-- Print Button -->
        <button onclick="window.print()" class="btn btn-success">
            <i class="fas fa-print"></i> طباعة
        </button>

        <!-- Import Excel Button - Link to the Import Page -->
        <a href="@Url.Action("ImportExcelPage", "Customer")" class="btn btn-secondary">
            <i class="fas fa-file-import"></i> استيراد من إكسيل
        </a>

        <!-- Export Excel Button -->
        <a href="@Url.Action("ExportToExcel", "Customer")" class="btn btn-secondary">
            <i class="fas fa-file-excel"></i> تصدير إكسيل
        </a>

        <!-- Export PDF Button -->
        <a href="@Url.Action("ExportToPdf", "Customer")" class="btn btn-secondary">
            <i class="fas fa-file-pdf"></i> تصدير PDF
        </a>
    </div>
</div>

<!-- Table Section -->
<div class="table-responsive" dir="rtl">
    <table class="table table-bordered table-striped table-hover">
        <thead class="thead-light">
            <tr>
                <th>كود العميل</th>
                <th>اسم العميل</th>
                <th>رقم الجوال</th>
                <th>العنوان</th>
                <th>المدينة</th>
                <th class="actions-column">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Customers.Any())
            {
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>@customer.CustomerCode</td>
                        <td>@customer.Name</td>
                        <td dir="ltr">@customer.MobileNumber</td>
                        <td>@customer.Address</td>
                        <td>@customer.City</td>
                        <td class="actions-column">
                            <a href="@Url.Action("Details", "Customer", new { id = customer.CustomerId })" 
                               class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", "Customer", new { id = customer.CustomerId })" 
                               class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", "Customer", new { id = customer.CustomerId })" 
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('هل أنت متأكد من حذف هذا العميل؟');">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">لا يوجد عملاء لعرضهم</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination Section -->
<div class="d-flex justify-content-between align-items-center">
    <!-- Previous Page Button -->
    @if (Model.CurrentPage > 1)
    {
        <a href="@Url.Action("Index", "Customer", new { page = Model.CurrentPage - 1, searchQuery = Model.SearchQuery })" class="btn btn-info">
            <i class="fas fa-chevron-left"></i> السابق
        </a>
    }

    <!-- Page Numbers -->
    <div>
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <a href="@Url.Action("Index", "Customer", new { page = i, searchQuery = Model.SearchQuery })" class="btn btn-outline-secondary @(i == Model.CurrentPage ? "active" : "")">
                @i
            </a>
        }
    </div>

    <!-- Next Page Button -->
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="@Url.Action("Index", "Customer", new { page = Model.CurrentPage + 1, searchQuery = Model.SearchQuery })" class="btn btn-info">
            التالي <i class="fas fa-chevron-right"></i>
        </a>
    }
</div>

<!-- Print Styles -->
<style>
    @@media print {
        .btn, .search-container, .actions-column {
            display: none !important;
        }
        
        table {
            width: 100% !important;
            font-size: 12px;
        }
        
        h1 {
            font-size: 18px;
        }
    }
</style>
