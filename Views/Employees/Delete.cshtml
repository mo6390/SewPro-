@model SewPro.Models.Employee

@{
    ViewData["Title"] = "حذف الموظف";
}

<h2>هل أنت متأكد من حذف هذا الموظف؟</h2>

<table class="table table-bordered">
    <tr><th>الاسم</th><td>@Model.Name</td></tr>
    <tr><th>البريد الإلكتروني</th><td>@Model.Email</td></tr>
    <tr><th>الهاتف</th><td>@Model.Phone</td></tr>
    <tr><th>الوظيفة</th><td>@Model.JobTitle</td></tr>
    <tr><th>الراتب</th><td>@Model.Salary.ToString("C")</td></tr>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EmployeeId">
    <button type="submit" class="btn btn-danger">حذف</button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
