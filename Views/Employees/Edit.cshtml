@model SewPro.Models.Employee

@{
    ViewData["Title"] = "تعديل الموظف";
}

<h2>تعديل بيانات الموظف</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="EmployeeId">
    <div class="form-group">
        <label>الاسم</label>
        <input asp-for="Name" class="form-control" required>
    </div>
    <div class="form-group">
        <label>البريد الإلكتروني</label>
        <input asp-for="Email" class="form-control" type="email" required>
    </div>
    <div class="form-group">
        <label>الهاتف</label>
        <input asp-for="Phone" class="form-control" type="tel" required>
    </div>
    <div class="form-group">
        <label>الوظيفة</label>
        <input asp-for="JobTitle" class="form-control" required>
    </div>
    <div class="form-group">
        <label>الراتب</label>
        <input asp-for="Salary" class="form-control" type="number" step="0.01" required>
    </div>
    <button type="submit" class="btn btn-warning mt-3">حفظ التعديلات</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">إلغاء</a>
</form>
