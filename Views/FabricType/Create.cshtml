@model SewPro.Models.FabricType

<h2>إضافة نوع قماش جديد</h2>
<form asp-action="Create">
    <label>الاسم العربي</label>
    <input asp-for="ArabicName" class="form-control" required />

    <label>الاسم الإنجليزي</label>
    <input asp-for="EnglishName" class="form-control" required />

    <label>ملاحظات</label>
    <textarea asp-for="Notes" class="form-control"></textarea>

    <button type="submit" class="btn btn-success mt-3">✔️ حفظ</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">🔙 إلغاء</a>
</form>
