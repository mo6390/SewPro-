@model SewPro.Models.Factory

<h2 class="text-danger">⚠️ تأكيد الحذف</h2>

<p>هل أنت متأكد أنك تريد حذف المصنع التالي؟</p>

<table class="table">
    <tr>
        <th>الاسم العربي:</th>
        <td>@Model.ArabicName</td>
    </tr>
    <tr>
        <th>الاسم الإنجليزي:</th>
        <td>@Model.EnglishName</td>
    </tr>
    <tr>
        <th>ملاحظات:</th>
        <td>@(string.IsNullOrEmpty(Model.Notes) ? "لا توجد ملاحظات" : Model.Notes)</td>
    </tr>
</table>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">🗑 حذف</button>
    <a asp-action="Index" class="btn btn-secondary">🔙 إلغاء</a>
</form>
