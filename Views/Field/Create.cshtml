@model SewPro.Models.Field

<h1>إضافة حقل جديد</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label>الاسم بالعربي</label>
        <input type="text" asp-for="ArabicName" class="form-control" />
    </div>

    <div class="form-group">
        <label>الاسم بالإنجليزي</label>
        <input type="text" asp-for="EnglishName" class="form-control" />
    </div>

    <div class="form-group">
        <label>نوع الحقل</label>
        <select asp-for="FieldType" class="form-control">
            <option value="TextBox">مربع نص</option>
            <option value="TextArea">نص متعدد</option>
            <option value="ImageUpload">رفع صورة</option>
            <option value="FileUpload">تحميل ملف</option>
            <option value="DropdownList">قائمة نصية</option>
            <option value="ImageList">قائمة مصورة</option>
            <option value="CheckBox">مربع اختيار</option>
        </select>
    </div>

    <div class="form-group">
        <label>إجباري</label>
        <input type="checkbox" asp-for="IsRequired" />
    </div>

    <div class="form-group">
        <label>يقبل أرقام فقط</label>
        <input type="checkbox" asp-for="NumbersOnly" />
    </div>

    <div class="form-group">
        <label>ملاحظات</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">حفظ</button>
</form>
