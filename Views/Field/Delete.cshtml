@model SewPro.Models.Field

<h1>تأكيد حذف الحقل</h1>

<p>هل أنت متأكد أنك تريد حذف الحقل التالي؟</p>

<table>
    <tr>
        <th>الاسم بالعربية:</th>
        <td>@Model.ArabicName</td>
    </tr>
    <tr>
        <th>الاسم بالإنجليزية:</th>
        <td>@Model.EnglishName</td>
    </tr>
    <tr>
        <th>نوع الحقل:</th>
        <td>@Model.FieldType</td>
    </tr>
    <tr>
        <th>هل الحقل إجباري؟</th>
        <td>@(Model.IsRequired ? "نعم" : "لا")</td>
    </tr>
    <tr>
        <th>هل يقبل أرقام فقط؟</th>
        <td>@(Model.NumbersOnly ? "نعم" : "لا")</td>
    </tr>
    <tr>
        <th>ملاحظات:</th>
        <td>@Model.Notes</td>
    </tr>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">حذف</button>
    <a href="/Field/Index" class="btn btn-secondary">إلغاء</a>
</form>
