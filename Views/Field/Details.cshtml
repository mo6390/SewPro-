@model SewPro.Models.Field

<h1>تفاصيل الحقل</h1>

<table>
    <tr>
        <th>الاسم بالعربية:</th>
        <td>@Model.ArabicName</td>
    </tr>
    <tr>
        <th>الاسم بالإنجليزية:</th>
        <td>@Model.EnglishName</td>
    </tr>
    <tr>
        <th>نوع الحقل:</th>
        <td>@Model.FieldType</td>
    </tr>
    <tr>
        <th>هل الحقل إجباري؟</th>
        <td>@(Model.IsRequired ? "نعم" : "لا")</td>
    </tr>
    <tr>
        <th>هل يقبل أرقام فقط؟</th>
        <td>@(Model.NumbersOnly ? "نعم" : "لا")</td>
    </tr>
    <tr>
        <th>ملاحظات:</th>
        <td>@Model.Notes</td>
    </tr>
</table>

<div style="margin-top: 20px;">
    <a href="/Field/Edit/@Model.Id" class="btn btn-primary">تعديل</a>
    <a href="/Field/Index" class="btn btn-secondary">العودة إلى القائمة</a>
</div>
