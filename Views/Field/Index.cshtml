@model IEnumerable<SewPro.Models.Field>

<h1>قائمة الحقول</h1>

<table class="table">
    <thead>
        <tr>
            <th>الاسم بالعربي</th>
            <th>الاسم بالإنجليزي</th>
            <th>نوع الحقل</th>
            <th>إجباري</th>
            <th>أرقام فقط</th>
            <th>ملاحظات</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var field in Model)
        {
            <tr>
                <td>@field.ArabicName</td>
                <td>@field.EnglishName</td>
                <td>@field.FieldType</td>
                <td>@(field.IsRequired ? "نعم" : "لا")</td>
                <td>@(field.NumbersOnly ? "نعم" : "لا")</td>
                <td>@field.Notes</td>
                <td>
                    <a href="@Url.Action("Details", new { id = field.Id })">تفاصيل</a> |
                    <a href="@Url.Action("Edit", new { id = field.Id })">تعديل</a> |
                    <form action="@Url.Action("Delete", new { id = field.Id })" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="@Url.Action("Create")" class="btn btn-primary">إضافة حقل جديد</a>
