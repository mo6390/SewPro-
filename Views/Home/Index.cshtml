    <!-- تحسين الأداء: تحميل JavaScript بشكل غير متزامن -->
    <script src="js/homepage.js" defer></script>
    <script>
        const ctx = document.getElementById('monthlyStatsChart').getContext('2d');
        const monthlyStatsChart = new Chart(ctx, {
            type: 'line', // نوع الرسم البياني (خطي)
            data: {
                labels: ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو'], // الشهور
                datasets: [{
                    label: 'المبيعات',
                    data: [65, 59, 80, 81, 56, 55], // البيانات
                    backgroundColor: 'rgba(75, 192, 192, 0.2)', // لون الخلفية
                    borderColor: 'rgba(75, 192, 192, 1)', // لون الخط
                    borderWidth: 2,
                    fill: true
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
