        <!-- زر أمر تفصيل -->
<div class="row mb-4">
    <div class="col-12 text-center">
        <a href="@Url.Action("index", "OrderDetail")" class="btn btn-custom-gradient btn-lg rounded-pill">
            <i class="fas fa-scissors me-2"></i> أمر تفصيل
        </a>
    </div>
</div>


        <!-- شريط البحث -->
        <div class="row mb-4">
            <div class="col-12">
                <input type="text" class="form-control" placeholder="ابحث عن عميل أو منتج أو قماش..." id="search-bar">
            </div>
        </div>

        <!-- إحصائيات العملاء -->
<div class="row mb-4">
    <!-- إحصائيات العملاء -->
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
