            <h6 class="card-title text-dark mb-0">إجمالي عدد العملاء</h6>
            <p class="fs-5" id="total-customers">@ViewData["TotalCustomers"]</p>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card text-center p-3 card-hover small-card card-new-customers-month">
            <h6 class="card-title text-dark mb-0">العملاء الجدد هذا الشهر</h6>
            <p class="fs-5" id="new-customers-month">@ViewData["NewCustomersMonth"]</p>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card text-center p-3 card-hover small-card card-new-customers-year">
            <h6 class="card-title text-dark mb-0">العملاء الجدد هذا العام</h6>
            <p class="fs-5" id="new-customers-year">@ViewData["NewCustomersYear"]</p>
        </div>
    </div>

    <!-- إحصائيات إضافية -->
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
