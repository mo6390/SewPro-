@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

<h2>إدارة المستخدمين</h2>
<a asp-action="CreateUser" class="btn btn-primary">إضافة مستخدم جديد</a>
<table class="table">
    <thead>
        <tr>
            <th>اسم المستخدم</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>
                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-warning">تعديل</a>
                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-danger" onclick="return confirm('هل أنت متأكد؟')">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
