@model SewPro.Models.Industry

<h2>هل أنت متأكد من حذف هذه الصناعة؟</h2>

<div>
    <strong>الاسم العربي:</strong> @Model.ArabicName
</div>
<div>
    <strong>الاسم الإنجليزي:</strong> @Model.EnglishName
</div>
<div>
    <strong>الملاحظات:</strong> @Model.Notes
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">حذف</button>
</form>

<a asp-action="Index">العودة للقائمة</a>
