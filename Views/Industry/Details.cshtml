@model SewPro.Models.Industry

<h2>تفاصيل الصناعة</h2>

<div class="card p-3 shadow">
    <div class="card-body">
        <h4 class="card-title">🚀 @Model.ArabicName (@Model.EnglishName)</h4>
        <p><strong>الملاحظات:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "لا توجد ملاحظات" : Model.Notes)</p>
        
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">✏️ تعديل</a>
        <a asp-action="Index" class="btn btn-secondary">🔙 العودة للقائمة</a>
    </div>
</div>
