@model SewPro.Models.Industry

<h2>تعديل بيانات الصناعة</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="ArabicName">الاسم العربي</label>
        <input asp-for="ArabicName" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="EnglishName">الاسم الإنجليزي</label>
        <input asp-for="EnglishName" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Notes">ملاحظات</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">حفظ التعديلات</button>
</form>

<a asp-action="Index">العودة للقائمة</a>
