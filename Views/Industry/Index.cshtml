@model IEnumerable<SewPro.Models.Industry>

<h2>قائمة الصناعات</h2>

<a asp-action="Create" class="btn btn-primary">إضافة صناعة جديدة</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>الاسم العربي</th>
            <th>الاسم الإنجليزي</th>
            <th>ملاحظات</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ArabicName</td>
                <td>@item.EnglishName</td>
                <td>@item.Notes</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">عرض</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
