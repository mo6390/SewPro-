@model SewPro.Models.ItemGroup

@{
    ViewData["Title"] = "تفاصيل مجموعة الأصناف";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <tr>
        <th>الاسم العربي:</th>
        <td>@Model.ArabicName</td>
    </tr>
    <tr>
        <th>الاسم الإنجليزي:</th>
        <td>@Model.EnglishName</td>
    </tr>
    <tr>
        <th>الملاحظات:</th>
        <td>@Model.Notes</td>
    </tr>
</table>

<a asp-action="Index" class="btn btn-secondary">رجوع</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">حذف</a>
