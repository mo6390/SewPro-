@model IEnumerable<SewPro.Models.ItemGroup>

@{
    ViewData["Title"] = "مجموعة الأصناف";
}

<h1>@ViewData["Title"]</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>الاسم العربي</th>
            <th>الاسم الإنجليزي</th>
            <th>الملاحظات</th>
            <th>الخيارات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ArabicName</td>
                <td>@item.EnglishName</td>
                <td>@item.Notes</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">عرض</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">إضافة مجموعة أصناف جديدة</a>
