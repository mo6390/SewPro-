@model SewPro.Models.ItemGroup

@{
    ViewData["Title"] = "حذف مجموعة الأصناف";
}

<h1>@ViewData["Title"]</h1>

<h3>هل أنت متأكد من أنك تريد حذف هذا العنصر؟</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">الاسم العربي</dt>
        <dd class="col-sm-10">@Model.ArabicName</dd>

        <dt class="col-sm-2">الاسم الإنجليزي</dt>
        <dd class="col-sm-10">@Model.EnglishName</dd>

        <dt class="col-sm-2">ملاحظات</dt>
        <dd class="col-sm-10">@Model.Notes</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">حذف</button>
    <a asp-action="Index" class="btn btn-secondary">رجوع</a>
</form>
