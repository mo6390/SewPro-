@model SewPro.Models.Item

@{
    ViewData["Title"] = "تفاصيل الصنف";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>تفاصيل الصنف</h4>
    <dl class="row">
        <dt class="col-sm-2">الأسم العربي</dt>
        <dd class="col-sm-10">@Model.ArabicName</dd>

        <dt class="col-sm-2">الأسم الإنجليزي</dt>
        <dd class="col-sm-10">@Model.EnglishName</dd>

        <dt class="col-sm-2">مجموعة الصنف</dt>
        <dd class="col-sm-10">@Model.ItemGroup.ArabicName</dd>

        <dt class="col-sm-2">سعر البيع</dt>
        <dd class="col-sm-10">@Model.Price.ToString("F2")</dd>

        <dt class="col-sm-2">الباركود</dt>
        <dd class="col-sm-10">@Model.Barcode</dd>

        <dt class="col-sm-2">الصورة</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="صورة الصنف" class="img-thumbnail" style="max-width: 200px;" />
            }
            else
            {
                <span>لا توجد صورة</span>
            }
        </dd>

        <dt class="col-sm-2">ملاحظات</dt>
        <dd class="col-sm-10">@Model.Notes</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
<a asp-action="Index" class="btn btn-secondary">رجوع</a>
