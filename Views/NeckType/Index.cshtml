@model IEnumerable<SewPro.Models.NeckType>

@{
    ViewData["Title"] = "أنواع الرقبة";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>اسم نوع الرقبة</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <!-- رابط لتعديل نوع الرقبة -->
                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning">تعديل</a>
                    <!-- رابط لحذف نوع الرقبة -->
                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- رابط لإضافة نوع رقبة جديد -->
<a href="@Url.Action("Create", "NeckType")" class="btn btn-primary">إضافة نوع رقبة جديد</a>
