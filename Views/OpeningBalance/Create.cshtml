@model SewPro.Models.OpeningBalance

@{
    ViewData["Title"] = "إنشاء رصيد افتتاحي";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <div class="form-group">
        <label for="CashBalance">الرصيد النقدي</label>
        <input type="number" class="form-control" id="CashBalance" name="CashBalance" required />
    </div>
    <div class="form-group">
        <label for="BankBalance">رصيد البنك</label>
        <input type="number" class="form-control" id="BankBalance" name="BankBalance" required />
    </div>
    <div class="form-group">
        <label for="CustomerReceivables">المستحقات من العملاء</label>
        <input type="number" class="form-control" id="CustomerReceivables" name="CustomerReceivables" required />
    </div>
    <div class="form-group">
        <label for="SupplierPayables">المستحقات للموردين</label>
        <input type="number" class="form-control" id="SupplierPayables" name="SupplierPayables" required />
    </div>
    <div class="form-group">
        <label for="Date">التاريخ</label>
        <input type="date" class="form-control" id="Date" name="Date" required />
    </div>
    <button type="submit" class="btn btn-primary">حفظ</button>
</form>
