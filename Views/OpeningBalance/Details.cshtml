@model SewPro.Models.OpeningBalance

@{
    ViewData["Title"] = "تفاصيل الرصيد الافتتاحي";
}

<h1>@ViewData["Title"]</h1>

<div>
    <strong>التاريخ:</strong> @Model.Date.ToString("yyyy-MM-dd")
</div>
<div>
    <strong>الرصيد النقدي:</strong> @Model.CashBalance
</div>
<div>
    <strong>رصيد البنك:</strong> @Model.BankBalance
</div>
<div>
    <strong>المستحقات من العملاء:</strong> @Model.CustomerReceivables
</div>
<div>
    <strong>المستحقات للموردين:</strong> @Model.SupplierPayables
</div>

<a href="@Url.Action("Index", "OpeningBalance")" class="btn btn-primary">العودة إلى القائمة</a>
