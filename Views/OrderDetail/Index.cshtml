@{
    Layout = null;  // Disable layout for this page
    ViewData["Title"] = "Order Detail";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        /* تخصيصات إضافية */
        .search-container {
            position: fixed;
            top: 10px;
            right: 10px;
            width: 25%;
            text-align: right;
            z-index: 1000;
            padding-top: 60px;
        }

        .search-results {
            position: absolute;
            width: 100%;
            z-index: 1000;
            background-color: white;
            border: 1px solid #ddd;
            max-height: 200px;
            overflow-y: auto;
            display: none;
            text-align: right;
        }

        .search-results li {
            padding: 8px;
            cursor: pointer;
            text-align: right;
        }

        .search-results li:hover {
            background-color: #f8f9fa;
        }

        .input-group {
            width: 100%;
            text-align: right;
        }

        .customer-details-wrapper {
            margin-top: 8px;
            display: flex;
            gap: 10px;
            align-items: flex-end;
            text-align: right;
        }
       .vr-mid {
            position: absolute;
            top: 0;
            left: 50%;
            width: 2px;
            height: 50%; /* يمتد فقط في النصف العلوي */
            background-color: #000;
            z-index: 999;
        }
        .customer-details-wrapper .form-group {
            margin-bottom: 0;
            flex: 1;
        }

        .customer-details-wrapper .form-control {
            width: 300px;
            font-size: 14px;
            padding:8px;
        }

        .form-inline .form-control {
            width: 100%;
            text-align: right;
        }
.customer-details-wrapper {
    display: flex;
    gap: 10px;
    align-items: flex-end;
}
.customer-details-wrapper .form-group {
    flex: 1;
}

        .btn-add-customer {
            margin-left: 0;
        }

        .form-group {

            margin-bottom: 0;
            text-align: right;
        }

        .btn-link {
            text-align: right;
            display: block;
            width: 100%;
        }

        .btn-link i {
            float: right;
            margin-left: 5px;
        }

        /* خط عرضي في منتصف الصفحة */
        .hr-mid {
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            border: none;
            height: 2px;
            background-color: #000;
            z-index: 999;
        }
    </style>
</head>
<body>
    <hr class="hr-mid"> <!-- الخط العرضي في المنتصف -->
    <div class="vr-mid"></div>

    <div class="container mt-5">
        <!-- زر العودة إلى الصفحة الرئيسية -->
        <a href="~/home" class="btn btn-link mb-4">
            <i class="fas fa-home"></i> العودة إلى الرئيسية
        </a>

        <!-- مربع البحث ونتائج البحث -->
        <div class="search-container">
            <div class="form-group">
                <label for="searchQuery"></label>
                <div class="input-group">
                    <input type="text" id="searchQuery" class="form-control" placeholder="ادخل اسم العميل..." />
                    <div class="input-group-append">
                        <button id="addCustomerBtn" class="btn btn-primary btn-add-customer" title="إضافة عميل جديد" data-toggle="modal" data-target="#addCustomerModal">
                            <i class="fas fa-plus"></i>
                        </button>
                        <span class="input-group-text" id="loadingSpinner">
                            <i class="fas fa-spinner fa-spin"></i>
                        </span>
                    </div>
                </div>
            </div>
            <ul id="searchResults" class="list-group search-results" style="display:none;"></ul>

            <div id="customerDetails" class="customer-details-wrapper">
    <div class="form-group">
        <input type="text" id="customerCode" class="form-control" placeholder="كود العميل" readonly />
    </div>
    <div class="form-group">
        <input type="text" id="customerName" class="form-control" placeholder="اسم العميل" readonly />
    </div>
    <div class="form-group">
        <input type="text" id="mobileNumber" class="form-control" placeholder="رقم الجوال" readonly />
    </div>
</div>

<!-- حاوية تحتوي على حقلي تاريخ الاستلام والتسليم في نفس السطر -->
<div class="customer-details-wrapper">
    <div class="form-group">
        <label for="receiptDate">تاريخ الاستلام</label>
        <input type="date" id="receiptDate" class="form-control" />
    </div>

    <div class="form-group">
        <label for="deliveryDate">تاريخ التسليم</label>
        <input type="date" id="deliveryDate" class="form-control" />
    </div>
</div>


    <!-- نافذة منبثقة لإضافة عميل جديد -->
    <div class="modal fade" id="addCustomerModal" tabindex="-1" role="dialog" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addCustomerModalLabel">إضافة عميل جديد</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="newCustomerForm">
                        <div class="form-group">
                            <label for="newCustomerName">اسم العميل:</label>
                            <input type="text" id="newCustomerName" class="form-control" placeholder="ادخل اسم العميل" required />
                        </div>
                        <div class="form-group">
                            <label for="newMobileNumber">رقم الجوال:</label>
                            <input type="text" id="newMobileNumber" class="form-control" placeholder="ادخل رقم الجوال" required />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">إلغاء</button>
                    <button type="button" id="saveCustomerBtn" class="btn btn-success">حفظ العميل</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
            // تعيين تاريخ اليوم كقيمة افتراضية لحقل تاريخ الاستلام
            var today = new Date().toISOString().split('T')[0]; // الحصول على تاريخ اليوم بالصيغة YYYY-MM-DD
            $("#receiptDate").val(today); // تعيين تاريخ اليوم إلى الحقل

            let currentRequest = null;

            // دالة debounce لتأخير الطلبات
            const debounce = (func, delay) => {
                let inDebounce;
                return function () {
                    const context = this;
                    const args = arguments;
                    clearTimeout(inDebounce);
                    inDebounce = setTimeout(() => func.apply(context, args), delay);
                };
            };

            // عند كتابة استعلام البحث
            $("#searchQuery").on("input", debounce(function () {
                const searchQuery = $(this).val().trim();

                // إلغاء الطلب السابق إذا كان موجودًا
                if (currentRequest) {
                    currentRequest.abort();
                }

                // إذا كان البحث فارغًا، امسح نتائج البحث
                if (searchQuery.length === 0) {
                    $("#searchResults").hide().empty();
                    $("#loadingSpinner").hide();
                    return;
                }

                // إظهار spinner التحميل
                $("#loadingSpinner").show();

                // إرسال استعلام البحث إلى الخادم
                currentRequest = $.ajax({
                    url: '@Url.Action("SearchCustomer", "OrderDetail")',
                    type: 'GET',
                    data: { searchQuery: searchQuery },
                    success: function (data) {
                        // إخفاء spinner التحميل
                        $("#loadingSpinner").hide();

                        // إذا كانت النتائج فارغة
                        if (data.length === 0) {
                            $("#searchResults").html('<li class="list-group-item">لا توجد نتائج</li>').show();
                        } else {
                            let resultsHtml = '';
                            // عرض العملاء في قائمة نتائج البحث
                            data.forEach(customer => {
                                resultsHtml += `<li class="list-group-item" data-customerId="${customer.customerId}" data-name="${customer.name}" data-mobile="${customer.mobileNumber}" data-customerCode="${customer.customerCode}">
                                                    ${customer.name}
                                                </li>`;
                            });
                            $("#searchResults").html(resultsHtml).show();
                        }
                    },
                    error: function (xhr, status, error) {
                        if (status !== 'abort') {
                            // إخفاء spinner التحميل عند حدوث خطأ
                            $("#loadingSpinner").hide();
                            console.error('حدث خطأ: ', error);
                        }
                    }
                });
            }, 300)); // تأخير لمدة 300 ميلي ثانية

            // عند اختيار عميل من نتائج البحث
            $(document).on("click", "#searchResults li", function () {
                const customerId = $(this).data("customerId");
                const name = $(this).data("name");
                const mobile = $(this).data("mobile");
                const customerCode = $(this).data("customerCode");

                // تعبئة الحقول بالمعلومات المختارة
                $("#customerCode").val(customerCode);
                $("#customerName").val(name);
                $("#mobileNumber").val(mobile);

                // إخفاء نتائج البحث
                $("#searchResults").hide().empty();
            });
        });
    </script>
</body>
</html>
