@model SewPro.Models.PaymentMethod

@{
    ViewData["Title"] = "تأكيد الحذف";
}

<h1>@ViewData["Title"]</h1>

<h3>هل أنت متأكد من أنك تريد حذف طريقة الدفع هذه؟</h3>

<div>
    <h4>@Model.NameAr</h4>
    <p>@Model.NameEn</p>
    <p>@Model.Notes</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />  <!-- إرسال المعرف إلى الخادم -->
    <button type="submit" class="btn btn-danger">حذف</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">إلغاء</a>
</form>
