@model IEnumerable<SewPro.Models.PocketShape>

@{
    ViewData["Title"] = "أشكال الجيب";
}

<h1>أشكال الجيب</h1>

<p>
    <a href="@Url.Action("Create")">إضافة شكل جيب جديد</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>تاريخ الإنشاء</th>
            <th>تاريخ التحديث</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var shape in Model)
        {
            <tr>
                <td>@shape.Name</td>
                <td>@shape.CreatedAt</td>
                <td>@shape.UpdatedAt</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = shape.Id })">تعديل</a> |
                    <a href="@Url.Action("Delete", new { id = shape.Id })">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
