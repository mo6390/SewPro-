@model SewPro.Models.SalaryPayment

@{
    ViewData["Title"] = "إضافة دفعة راتب جديدة";
}

<h1>@ViewData["Title"]</h1>

<h4>دفعة راتب</h4>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.EmployeeId, "الموظف")
        @Html.DropDownListFor(model => model.EmployeeId, (SelectList)ViewData["EmployeeId"], "اختر الموظف", new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.EmployeeId)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.PaymentDate, "تاريخ الدفع")
        @Html.EditorFor(model => model.PaymentDate, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.PaymentDate)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.GrossSalary, "الراتب الإجمالي")
        @Html.EditorFor(model => model.GrossSalary, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.GrossSalary)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Deductions, "الخصومات")
        @Html.EditorFor(model => model.Deductions, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Deductions)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Bonus, "المكافأة")
        @Html.EditorFor(model => model.Bonus, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Bonus)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.TotalPayment, "إجمالي الدفع")
        @Html.EditorFor(model => model.TotalPayment, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.TotalPayment)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.PaymentMethod, "طريقة الدفع")
        @Html.EditorFor(model => model.PaymentMethod, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.PaymentMethod)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.PaymentStatus, "حالة الدفع")
        @Html.EditorFor(model => model.PaymentStatus, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.PaymentStatus)
    </div>

    <div class="form-group">
        <input type="submit" value="حفظ" class="btn btn-success" />
    </div>
}

<a href="@Url.Action("Index", "SalaryPayments")" class="btn btn-default">الرجوع إلى القائمة</a>
