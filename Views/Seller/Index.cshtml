@model IEnumerable<SewPro.Models.Seller>

@{
    ViewData["Title"] = "عرض البائعين";
    Layout = "_Layout";  <!-- تأكد من أن هذا يشير إلى الـ layout الصحيح -->
}

<h1>@ViewData["Title"]</h1>

<!-- إضافة CSS داخل الصفحة -->
<style>
    table {
        width: 100%;
        margin-top: 20px;
    }

    th, td {
        text-align: center;
        padding: 8px;
    }

 

    .btn {
        margin-right: 5px;
    }

    .table-bordered {
        border: 1px solid #ddd;
    }
</style>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>رقم الجوال</th>
            <th>الوظيفة</th>
            <th>الاسم بالإنجليزي</th>
            <th>البريد الإلكتروني</th>
            <th>العنوان</th>
            <th>الجنسية</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var seller in Model)
        {
            <tr>
                <td>@seller.Name</td>
                <td>@seller.PhoneNumber</td>
                <td>@seller.JobTitle</td>
                <td>@seller.EnglishName</td>
                <td>@seller.Email</td>
                <td>@seller.Address</td>
                <td>@seller.Nationality</td>
                <td>
                    <!-- أزرار للتفاصيل، التعديل، والحذف -->
                    <a href="@Url.Action("Edit", "Seller", new { id = seller.SellerId })" class="btn btn-warning btn-sm">تعديل</a>
                    <a href="@Url.Action("Delete", "Seller", new { id = seller.SellerId })" class="btn btn-danger btn-sm">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- زر لإضافة بائع جديد -->
<a href="@Url.Action("Create", "Seller")" class="btn btn-primary">إضافة بائع جديد</a>
