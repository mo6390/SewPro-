@model IEnumerable<SewPro.Models.SleeveShape>
@{
    ViewData["Title"] = "إضافة شكل جيب جديد";
}
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>CreatedAt</th>
            <th>UpdatedAt</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.CreatedAt</td>
                <td>@item.UpdatedAt</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.Id })">Edit</a> | 
                    <a href="@Url.Action("Delete", new { id = item.Id })">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
