@model SewPro.Models.StatusViewModel

@{
    ViewData["Title"] = "حالة الثوب";
}

<h2>حالة الثوب</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="ArabicName">الاسم العربي *</label>
        <input type="text" class="form-control" id="ArabicName" name="ArabicName" value="@Model.ArabicName" required />
    </div>

    <div class="form-group">
        <label for="EnglishName">الاسم الإنجليزي *</label>
        <input type="text" class="form-control" id="EnglishName" name="EnglishName" value="@Model.EnglishName" required />
    </div>

    <div class="form-group">
        <label for="Status">حالة الثوب *</label>
        <select class="form-control" id="Status" name="Status" required>
            <option value="UnderWork">تحت العمل</option>
            <option value="Ready">جاهز</option>
            <option value="Modification">تعديل</option>
        </select>
    </div>

    <div class="form-group">
        <label for="SmsMessage">رسالة SMS</label>
        <textarea class="form-control" id="SmsMessage" name="SmsMessage" readonly>
عزيزي العميل @Model.CustomerName
تم استلام طلبكم وسيتم العمل عليه في أسرع وقت ممكن
@Model.BranchName
اسم العميل: @Model.CustomerName - الفرع: @Model.BranchName - رقم الإذن: @Model.TransCode
        </textarea>
    </div>

    <div class="form-group">
        <label for="Notes">ملاحظات</label>
        <textarea class="form-control" id="Notes" name="Notes">@Model.Notes</textarea>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">حفظ</button>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">رجوع</a>
    </div>
</form>

<!-- زر إرسال تقييم -->
<div class="form-group">
    <button class="btn btn-success">إرسال تقييم للعميل</button>
</div>
