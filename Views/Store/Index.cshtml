@model IEnumerable<SewPro.Models.Store>

<h2>المخازن</h2>

<p>
    <a href="@Url.Action("Create", "Store")">إضافة مخزن جديد</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الموقع</th>
            <th>التاريخ</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Location</td>
            <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td>
                <a href="@Url.Action("Edit", "Store", new { id = item.Id })">تعديل</a> |
                <a href="@Url.Action("Delete", "Store", new { id = item.Id })">حذف</a> |
                <a href="@Url.Action("Details", "Store", new { id = item.Id })">تفاصيل</a>
            </td>
        </tr>
    }
    </tbody>
</table>
