@model SewPro.Models.SupplierPayment

@{
    ViewData["Title"] = "إضافة دفعة جديدة";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <div class="form-group">
        <label for="SupplierId">المورد</label>
        <select asp-for="SupplierId" class="form-control" asp-items="@(new SelectList(ViewData["Suppliers"] as IEnumerable<SewPro.Models.Supplier>, "Id", "Name"))"></select>
    </div>

    <div class="form-group">
        <label for="AmountDue">المبلغ المستحق</label>
        <input type="number" step="0.01" asp-for="AmountDue" class="form-control" />
    </div>

    <div class="form-group">
        <label for="AmountPaid">المبلغ المدفوع</label>
        <input type="number" step="0.01" asp-for="AmountPaid" class="form-control" />
    </div>

    <div class="form-group">
        <label for="DueDate">تاريخ الاستحقاق</label>
        <input type="date" asp-for="DueDate" class="form-control" />
    </div>

    <div class="form-group">
        <label for="PaymentDate">تاريخ الدفع</label>
        <input type="date" asp-for="PaymentDate" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">حفظ</button>
</form>
