@model IEnumerable<SewPro.Models.SupplierPayment>

@{
    ViewData["Title"] = "قائمة المدفوعات";
}

<h2>@ViewData["Title"]</h2>

<a href="@Url.Action("Create", "SupplierPayment")" class="btn btn-primary mb-3">إضافة دفعة جديدة</a>

<table class="table">
    <thead>
        <tr>
            <th>اسم المورد</th>
            <th>المبلغ المستحق</th>
            <th>المبلغ المدفوع</th>
            <th>تاريخ الاستحقاق</th>
            <th>تاريخ الدفع</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model)
        {
            <tr>
                <td>@payment.Supplier.Name</td>
                <td>@payment.AmountDue</td>
                <td>@payment.AmountPaid</td>
                <td>@payment.DueDate.ToString("yyyy-MM-dd")</td>
                <td>@(payment.PaymentDate.HasValue ? payment.PaymentDate.Value.ToString("yyyy-MM-dd") : "لم يتم الدفع بعد")</td>
                <td>
                    <a href="@Url.Action("Edit", "SupplierPayment", new { id = payment.Id })" class="btn btn-warning btn-sm">تعديل</a>
                    <a href="@Url.Action("Delete", "SupplierPayment", new { id = payment.Id })" class="btn btn-danger btn-sm">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
