@model SewPro.Models.Customer

@{
    ViewData["Title"] = "حذف عميل";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>هل أنت متأكد أنك تريد حذف العميل؟</h4>
    <div>
        <strong>اسم العميل:</strong> @Model.Name
    </div>
    <div>
        <strong>رقم الجوال:</strong> @Model.MobileNumber
    </div>
    <div>
        <strong>العنوان:</strong> @Model.Address
    </div>
    <div>
        <strong>المدينة:</strong> @Model.City
    </div>

    <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post">
        <input type="submit" value="حذف" class="btn btn-danger" />
        <a href="@Url.Action("Index", "Customer")" class="btn btn-secondary">إلغاء</a>
    </form>
</div>
