@model SewPro.Models.Supplier

@{
    ViewData["Title"] = "تفاصيل المورد";
}

<h2>@ViewData["Title"]</h2>

<div class="form-group">
    <label>الاسم:</label>
    <p>@Model.Name</p>
</div>

<div class="form-group">
    <label>رقم الجوال:</label>
    <p>@Model.PhoneNumber</p>
</div>

<div class="form-group">
    <label>البريد الإلكتروني:</label>
    <p>@Model.Email</p>
</div>

<div class="form-group">
    <label>العنوان:</label>
    <p>@Model.Address</p>
</div>

<div class="form-group">
    <label>رقم الضريبة:</label>
    <p>@Model.TaxNumber</p>
</div>

<div class="form-group">
    <label>ملاحظات:</label>
    <p>@Model.Notes</p>
</div>

<a href="@Url.Action("Index", "Supplier")" class="btn btn-secondary">رجوع إلى القائمة</a>
