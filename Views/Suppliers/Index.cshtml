@model IEnumerable<SewPro.Models.Supplier>

@{
    ViewData["Title"] = "قائمة الموردين";
}

<h2>@ViewData["Title"]</h2>

<a href="@Url.Action("Create", "Suppliers")" class="btn btn-primary mb-3">إضافة مورد جديد</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>رقم الجوال</th>
            <th>البريد الإلكتروني</th>
            <th>العنوان</th>
            <th>الرقم الضريبي</th>
            <th>الملاحظات</th>
            <th>الحالة النشطة</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Name</td>
                <td>@supplier.PhoneNumber</td>
                <td>@supplier.Email</td>
                <td>@supplier.Address</td>
                <td>@supplier.TaxNumber</td>
                <td>@supplier.Notes</td>
                <td>@(supplier.IsActive ? "نشط" : "غير نشط")</td>
                <td>
                    <a href="@Url.Action("Details", "Supplier", new { id = supplier.Id })" class="btn btn-info btn-sm">تفاصيل</a>
                    <a href="@Url.Action("Edit", "Supplier", new { id = supplier.Id })" class="btn btn-warning btn-sm">تعديل</a>
                    <a href="@Url.Action("Delete", "Supplier", new { id = supplier.Id })" class="btn btn-danger btn-sm">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
