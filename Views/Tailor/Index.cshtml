@model IEnumerable<SewPro.Models.Tailor>

@{
    ViewData["Title"] = "قائمة الخياطين";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a href="@Url.Action("Create", "Tailor")" class="btn btn-primary">إضافة خياط جديد</a>
</p>

<div class="container-fluid">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>اسم الخياط</th>
                <th class="actions-column">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tailor in Model)
            {
                <tr>
                    <td>@tailor.Name</td>
                    <td>
                        <a href="@Url.Action("Delete", "Tailor", new { id = tailor.TailorId })" class="btn btn-danger" onclick="return confirm('هل أنت متأكد من أنك تريد حذف هذا الخياط؟')">
                            <i class="fas fa-trash-alt"></i> حذف
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
