@model SewPro.ViewModels.TemplateViewModel

@{
    ViewData["Title"] = "إنشاء قالب جديد";
}

<h2>إنشاء قالب جديد</h2>

<form asp-action="SaveTemplate" method="post">
    <!-- حقول النموذج -->
    <div class="form-group">
        <label asp-for="ArabicName" class="control-label"></label>
        <input asp-for="ArabicName" class="form-control" />
        <span asp-validation-for="ArabicName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EnglishName" class="control-label"></label>
        <input asp-for="EnglishName" class="form-control" />
        <span asp-validation-for="EnglishName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TemplateType" class="control-label"></label>
        <select asp-for="TemplateType" class="form-control">
            <option value="Type1">النوع 1</option>
            <option value="Type2">النوع 2</option>
        </select>
        <span asp-validation-for="TemplateType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>
            <input asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
        </label>
    </div>
    <div class="form-group">
        <label>
            <input asp-for="ShowNameWithValue" /> @Html.DisplayNameFor(model => model.ShowNameWithValue)
        </label>
    </div>
    <div class="form-group">
        <label>
            <input asp-for="ShowBorderAroundField" /> @Html.DisplayNameFor(model => model.ShowBorderAroundField)
        </label>
    </div>

    <!-- مكتبة المكونات الجاهزة -->
    <div class="form-group mt-3">
        <label>مكتبة المكونات</label>
        <div id="component-library" class="component-library">
            <div class="component" data-type="text">نص</div>
            <div class="component" data-type="table">جدول</div>
            <div class="component" data-type="image">صورة</div>
            <div class="component" data-type="button">زر</div>
        </div>
    </div>

    <!-- قائمة منسدلة للحقول المتاحة -->
    <div class="form-group mt-3">
        <label>الحقول المتاحة</label>
        <select id="available-fields" class="form-control">
            @if (Model.AvailableFields != null)
            {
                foreach (var field in Model.AvailableFields)
                {
                    <option value="@field.Id">@field.ArabicName</option>
                }
            }
        </select>
    </div>

    <!-- خيارات التصميم -->
    <div class="form-group mt-3">
        <label>تغيير اللون</label>
        <input type="color" id="field-color" class="form-control" />
    </div>
    <div class="form-group">
        <label>حجم الخط</label>
        <input type="number" id="font-size" class="form-control" value="14" />
    </div>
    <div class="form-group">
        <label>محاذاة النص</label>
        <select id="text-align" class="form-control">
            <option value="left">يسار</option>
            <option value="center">مركز</option>
            <option value="right">يمين</option>
        </select>
    </div>

    <!-- حاوية التصميم -->
    <div class="container mt-3">
        <h3>تصميم القالب</h3>
        <div id="template-design-container" class="template-design-container" style="position: relative; width: 100%; height: 500px; border: 1px solid #ccc; background-image: linear-gradient(to right, #ccc 1px, transparent 1px), linear-gradient(to bottom, #ccc 1px, transparent 1px); background-size: 20px 20px;">
            <div id="fields-container" class="fields-container" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></div>
        </div>
    </div>

    <!-- معاينة مباشرة -->
    <div class="form-group mt-3">
        <h3>معاينة القالب</h3>
        <div id="live-preview" class="live-preview" style="border: 1px solid #ccc; padding: 20px; background-color: #f9f9f9;">
            <!-- سيتم عرض المعاينة هنا -->
        </div>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="حفظ القالب" class="btn btn-primary" id="save-template" />
    </div>
</form>

<!-- إعادة تعيين التصميم -->
<div class="form-group mt-3">
    <button type="button" id="reset-design" class="btn btn-warning">إعادة تعيين التصميم</button>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">العودة إلى القائمة</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/interactjs/dist/interact.min.js"></script>
    <script>
        $(document).ready(function () {
            // إضافة الحقل المحدد من القائمة المنسدلة إلى حاوية التصميم
            $('#available-fields').change(function () {
                var selectedField = $(this).find('option:selected');
                if (selectedField.length > 0) {
                    var fieldId = selectedField.val();
                    var fieldName = selectedField.text();

                    // إنشاء حقل جديد في حاوية التصميم
                    var newField = $("<div class='draggable-field' id='field-" + fieldId + "' data-field-id='" + fieldId + "' style='position: absolute; width: 120px; height: 40px; border: 1px solid #000; background-color: lightgray; padding: 5px; cursor: move; text-align: center;'>" + fieldName + "</div>");
                    $("#fields-container").append(newField);

                    // جعل الحقل الجديد قابل للسحب
                    interact(newField[0]).draggable({
                        inertia: true,
                        modifiers: [
                            interact.modifiers.restrictRect({
                                restriction: 'parent',
                                endOnly: true
                            })
                        ],
                        autoScroll: true,
                        listeners: {
                            move: function (event) {
                                var target = event.target;
                                var x = (parseFloat(target.getAttribute('data-x')) || 0) + event.dx;
                                var y = (parseFloat(target.getAttribute('data-y')) || 0) + event.dy;

                                target.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
                                target.setAttribute('data-x', x);
                                target.setAttribute('data-y', y);
                            },
                            start: function (event) {
                                event.target.style.cursor = 'grabbing';
                            },
                            end: function (event) {
                                event.target.style.cursor = 'grab';
                            }
                        }
                    });
                }
            });

            // إضافة المكونات من المكتبة إلى حاوية التصميم
            $('.component').on('click', function () {
                var componentType = $(this).data('type');
                var componentId = 'component-' + Date.now();
                var componentContent = $(this).text();

                var newComponent = $("<div class='draggable-field' id='" + componentId + "' data-type='" + componentType + "' style='position: absolute; width: 120px; height: 40px; border: 1px solid #000; background-color: lightgray; padding: 5px; cursor: move; text-align: center;'>" + componentContent + "</div>");
                $("#fields-container").append(newComponent);

                // جعل المكون الجديد قابل للسحب
                interact(newComponent[0]).draggable({
                    inertia: true,
                    modifiers: [
                        interact.modifiers.restrictRect({
                            restriction: 'parent',
                            endOnly: true
                        })
                    ],
                    autoScroll: true,
                    listeners: {
                        move: function (event) {
                            var target = event.target;
                            var x = (parseFloat(target.getAttribute('data-x')) || 0) + event.dx;
                            var y = (parseFloat(target.getAttribute('data-y')) || 0) + event.dy;

                            target.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
                            target.setAttribute('data-x', x);
                            target.setAttribute('data-y', y);
                        },
                        start: function (event) {
                            event.target.style.cursor = 'grabbing';
                        },
                        end: function (event) {
                            event.target.style.cursor = 'grab';
                        }
                    }
                });
            });

            // جعل حاوية التصميم قابلة لاستقبال الحقول (إفلات الحقل)
            interact('#fields-container').dropzone({
                accept: '.draggable-field',
                overlap: 0.75,
                ondrop: function (event) {
                    console.log('تم إسقاط الحقل في حاوية التصميم');
                    var fieldId = event.relatedTarget.getAttribute('id');
                    var fieldType = event.relatedTarget.getAttribute('data-type');
                    console.log("تم إسقاط الحقل: " + fieldType + " (ID: " + fieldId + ")");
                }
            });

            // حفظ القالب مع التعديلات
            $('#save-template').click(function () {
                var templateData = {
                    fields: [],
                    designSettings: {
                        color: $('#field-color').val(),
                        fontSize: $('#font-size').val(),
                        textAlign: $('#text-align').val(),
                    }
                };

                $('#fields-container .draggable-field').each(function () {
                    var field = {
                        id: $(this).attr('id'),
                        type: $(this).data('type') || 'field', // إذا كان حقلًا من القائمة المنسدلة
                        position: {
                            x: $(this).position().left,
                            y: $(this).position().top
                        }
                    };
                    templateData.fields.push(field);
                });

                // إرسال البيانات إلى الخادم
                $.ajax({
                    url: '@Url.Action("SaveTemplate", "Template")',
                    type: 'POST',
                    data: JSON.stringify(templateData),
                    contentType: 'application/json',
                    success: function (response) {
                        alert('تم حفظ القالب بنجاح');
                    },
                    error: function () {
                        alert('حدث خطأ أثناء حفظ القالب');
                    }
                });
            });

            // إعادة تعيين التصميم
            $('#reset-design').click(function () {
                $('#fields-container').empty();
            });

            // تحديث المعاينة المباشرة
            function updateLivePreview() {
                var previewHtml = '';
                $('#fields-container .draggable-field').each(function () {
                    var fieldContent = $(this).text();
                    var fieldStyle = $(this).attr('style');
                    previewHtml += "<div style='" + fieldStyle + "'>" + fieldContent + "</div>";
                });
                $('#live-preview').html(previewHtml);
            }

            // تحديث المعاينة عند تغيير التصميم
            $('#fields-container').on('DOMSubtreeModified', function () {
                updateLivePreview();
            });
        });
    </script>
}

<style>
    /* تنسيق النموذج */
    .form-group {
        margin-bottom: 15px;
    }

    .control-label {
        font-weight: bold;
    }

    input.form-control, select.form-control, textarea.form-control {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
    }

    .text-danger {
        color: red;
    }

    /* تصميم حاوية الحقل القابل للسحب */
    .draggable-field {
        padding: 10px;
        background-color: lightgray;
        border: 1px solid #ccc;
        width: 150px;
        height: 50px;
        text-align: center;
        cursor: move;
        position: absolute;
        border-radius: 5px;
    }

    /* تنسيق حاوية التصميم */
    .template-design-container {
        position: relative;
        width: 100%;
        height: 500px;
        border: 2px solid #ccc;
        background-color: #f9f9f9;
        background-image: linear-gradient(to right, #ccc 1px, transparent 1px), linear-gradient(to bottom, #ccc 1px, transparent 1px);
        background-size: 20px 20px;
        margin-top: 20px;
    }

    .fields-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    /* تنسيق زر حفظ القالب */
    #save-template {
        width: 100%;
        padding: 10px;
        background-color: #007bff;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 16px;
        border-radius: 5px;
    }

    #save-template:hover {
        background-color: #0056b3;
    }

    /* تنسيق زر إعادة تعيين التصميم */
    #reset-design {
        width: 100%;
        padding: 10px;
        background-color: #f0ad4e;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 16px;
        border-radius: 5px;
    }

    #reset-design:hover {
        background-color: #ec971f;
    }

    /* تنسيق مكتبة المكونات */
    .component-library {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .component {
        padding: 10px;
        background-color: #007bff;
        color: white;
        border-radius: 5px;
        cursor: pointer;
    }

    .component:hover {
        background-color: #0056b3;
    }

    /* تنسيق المعاينة المباشرة */
    .live-preview {
        margin-top: 20px;
    }
</style>