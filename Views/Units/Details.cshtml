@model SewPro.Models.Unit

@{
    ViewData["Title"] = "تفاصيل الوحدة";
}

<h2>تفاصيل الوحدة</h2>

<div class="form-group">
    <label>الاسم العربي:</label>
    <p>@Model.ArabicName</p>
</div>
<div class="form-group">
    <label>الاسم الإنجليزي:</label>
    <p>@Model.EnglishName</p>
</div>
<div class="form-group">
    <label>ملاحظات:</label>
    <p>@Model.Notes</p>
</div>

<a asp-action="Index" class="btn btn-secondary">رجوع</a>
