@model IEnumerable<SewPro.Models.Unit>

@{
    ViewData["Title"] = "قائمة الوحدات";
}

<h2>قائمة الوحدات</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>الاسم العربي</th>
            <th>الاسم الإنجليزي</th>
            <th>ملاحظات</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var unit in Model)
        {
            <tr>
                <td>@unit.ArabicName</td>
                <td>@unit.EnglishName</td>
                <td>@unit.Notes</td>
                <td>
                    <a asp-action="Details" asp-route-id="@unit.Id" class="btn btn-info">التفاصيل</a>
                    <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-warning">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@unit.Id" class="btn btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Create" class="btn btn-primary">إضافة وحدة جديدة</a>
